[Unit]
Description=KronosStock K-Semiconductor Flow Desk one-shot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/agent-workspaces/KronosStock
ExecStart=/srv/kronostock/kronostock-ksf-once.sh
TimeoutStartSec=900
Nice=5

[Install]
WantedBy=multi-user.target
