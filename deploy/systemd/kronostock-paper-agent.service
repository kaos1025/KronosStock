# Repository template only. Disabled by default; do not install or enable without approval.
[Unit]
Description=KronosStock isolated event-sourced paper agent cycle
Requires=kronostock-ksf.service
After=local-fs.target kronostock-ksf.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/agent-workspaces/KronosStock
EnvironmentFile=/etc/kronostock/paper-agent.env
ExecStartPre=/srv/agent-workspaces/KronosStock/scripts/deploy/produce-paper-response-bundle-once.sh
ExecStart=/srv/agent-workspaces/KronosStock/scripts/deploy/kronostock-paper-agent-once.sh
# Wrapper final handoff (legacy contract): ExecStart=/srv/agent-workspaces/KronosStock/.venv/bin/python -m strategy.paper_cycle --once
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kronostock /run/kronostock
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
# The producer is an approval-gated offline adapter; a nonzero exit prevents the consumer from starting.
# Telegram delivery is a separate approval-gated adapter; this unit has no network path.
